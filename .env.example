# Copy to .env and adjust. Never commit .env.

APP_NAME="My School API"
APP_ENV=development
DEBUG=true

# SQLite for local development; PostgreSQL in CI/production:
# DATABASE_URL=postgresql+asyncpg://myschool:myschool@localhost:5432/myschool
DATABASE_URL=sqlite+aiosqlite:///./var/dev.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-development-only-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30

# School secret that allows teacher self-registration.
TEACHER_INVITE_CODE=TEACHER-DEMO-1404

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

SCHOOL_TIMEZONE=Asia/Tehran
